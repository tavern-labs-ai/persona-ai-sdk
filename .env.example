# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RUN_LIVE_PROVIDER_TESTS=0

# Amazon Bedrock uses the standard AWS credential provider chain.
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Hosted service example. Use different scoped keys for different tenants.
CHARACTER_MEMORY_API_KEYS=local-development-key:local

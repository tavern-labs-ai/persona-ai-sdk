{
  "name": "persona-ai-sdk",
  "version": "1.0.3",
  "description": "Persona AI SDK: default personas, durable character memory, and Bedrock/OpenAI adapters in one package.",
  "keywords": [
    "ai",
    "sdk",
    "personality",
    "persona",
    "characters",
    "memory",
    "bedrock",
    "llm",
    "tavern-labs"
  ],
  "license": "MIT",
  "author": "Tavern Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tavern-labs-ai/persona-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/tavern-labs-ai/persona-ai-sdk/issues"
  },
  "homepage": "https://github.com/tavern-labs-ai/persona-ai-sdk#readme",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./personas": {
      "types": "./personas.d.mts",
      "import": "./personas.mjs"
    },
    "./personas/*": "./personas/*.json",
    "./openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    },
    "./bedrock": {
      "types": "./dist/providers/bedrock.d.ts",
      "import": "./dist/providers/bedrock.js"
    },
    "./persona": {
      "types": "./dist/persona/index.d.ts",
      "import": "./dist/persona/index.js"
    },
    "./sillytavern": {
      "types": "./dist/sillytavern/index.d.ts",
      "import": "./dist/sillytavern/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "import": "./dist/evaluation/index.js"
    },
    "./stores/json-file": {
      "types": "./dist/stores/json-file.d.ts",
      "import": "./dist/stores/json-file.js"
    },
    "./stores/sqlite": {
      "types": "./dist/stores/sqlite.d.ts",
      "import": "./dist/stores/sqlite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "personas",
    "personas.mjs",
    "cache-warm.mjs",
    "personas.d.mts",
    "index.mjs",
    "index.d.mts",
    "README.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "docs",
    "examples",
    "extensions",
    ".env.example",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-personas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run docs:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1158.0",
    "openai": "^7.45.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

{
  "name": "persona-ai-sdk",
  "version": "0.1.0",
  "description": "Provider-neutral, structured long-term memory for AI characters and conversational agents.",
  "keywords": [
    "ai",
    "character",
    "memory",
    "openai",
    "bedrock",
    "roleplay",
    "llm"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    },
    "./bedrock": {
      "types": "./dist/providers/bedrock.d.ts",
      "import": "./dist/providers/bedrock.js"
    },
    "./stores/json-file": {
      "types": "./dist/stores/json-file.d.ts",
      "import": "./dist/stores/json-file.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1158.0",
    "openai": "^7.45.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
